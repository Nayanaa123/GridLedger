# Copy this file to .env and fill in your values
PORT=5000
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gridledger?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/gridledger
MONGO_URI=mongodb://127.0.0.1:27017/gridledger
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
